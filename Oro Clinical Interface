<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>OROBORO Clinical Simulation Interface</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<style>

html,body{
  margin:0;
  padding:0;
  overflow:hidden;
  background:#02030a;
  font-family: Segoe UI, Arial, sans-serif;
  color:white;
}

canvas{
  display:block;
}

#dashboard{
  position:absolute;
  top:20px;
  left:20px;
  width:360px;
  background: rgba(10,15,30,.92);
  border: 1px solid #334;
  border-radius:16px;
  padding:20px;
  z-index:10;
  box-shadow: 0 0 30px #000;
  max-height: 90vh;
  overflow-y: auto;
}

#readout-panel{
  position:absolute;
  top:20px;
  right:20px;
  width:340px;
  background: rgba(10,15,30,.92);
  border: 1px solid #334;
  border-radius:16px;
  padding:20px;
  z-index:10;
  box-shadow: 0 0 30px #000;
  max-height: 90vh;
  display:flex;
  flex-direction:column;
}

#event-log{
  flex:1;
  overflow-y:auto;
  font-size:12px;
  line-height:1.5;
  max-height: 60vh;
  padding-right:4px;
}

.event-line{
  padding:4px 6px;
  border-bottom:1px solid #223;
  color:#cdd;
}

.event-line:first-child{
  color:#7fffb0;
}

#zoom-hint{
  position:absolute;
  bottom:20px;
  left:20px;
  z-index:10;
  font-size:12px;
  color:#889;
  background: rgba(10,15,30,.7);
  padding:6px 12px;
  border-radius:8px;
}

h1{
  font-size:22px;
  margin-top:0;
}

h3{
  margin-bottom:6px;
}

.status{
  padding:10px;
  border-radius:8px;
  background:#111;
  margin-bottom:15px;
}

.online{
  color:#00ff88;
}

.offline{
  color:#ff4444;
}

.card{
  background:#080c18;
  padding:12px;
  margin-top:12px;
  border-radius:10px;
}

button,input{
  width:100%;
  margin-top:8px;
  padding:8px;
  border-radius:6px;
  border:none;
  box-sizing: border-box;
}

button{
  background:#334cff;
  color:white;
  cursor:pointer;
}

button:hover{
  background:#5566ff;
}

pre{
  white-space:pre-wrap;
  font-size:13px;
}

</style>

</head>


<body>


<div id="dashboard">


<h1>🌀 OROBORO Clinical Engine</h1>

<div id="connection" class="status">
Connecting...
</div>

<div class="card">
<h3>Live Population</h3>
<pre id="telemetry">Waiting...</pre>
</div>

<div class="card">
<h3>Simulation Controls</h3>

<label>Intervention Strength</label>
<input id="intervention" type="range" min="0" max="100" value="30">

<button onclick="saveScenario()">Save Scenario</button>
<button onclick="loadScenario()">Load Scenario</button>
</div>

<div class="card">
<h3>Synthetic Data Generator</h3>

<label>Test Population Size</label>
<input id="testPopulation" type="number" value="500" min="10" max="5000">

<button onclick="generateSyntheticPopulation()">Generate Random Population</button>

<div id="generatorStatus">Ready</div>
</div>

<div class="card">
<h3>System Map</h3>
<div>
🔵 Susceptible<br>
🟡 Exposed<br>
🔴 Infectious<br>
🟢 Recovered<br>
⚪ Hospitalized
</div>
</div>

</div>


<div id="readout-panel">

<h3>📋 Researcher Readout</h3>
<div style="font-size:11px;color:#889;margin-bottom:8px;">
Live transmission &amp; state-change events
</div>

<div id="event-log">
Waiting for events...
</div>

</div>


<div id="zoom-hint">
🔍 Scroll to zoom in / out on the population
</div>


<script>

// ====================================
// CONNECTION
// ====================================

const API = "http://127.0.0.1:8000";

// ====================================
// SYNTHETIC DATA GENERATOR
// ====================================

async function generateSyntheticPopulation(){

  let size = Number(document.getElementById("testPopulation").value);

  try{
    let response = await fetch(API + "/generate_test_population?size=" + size);
    let result = await response.json();

    document.getElementById("generatorStatus").innerHTML =
      `Synthetic population loaded<br>Agents: ${result.population}`;

    console.log(result);
  }
  catch(error){
    document.getElementById("generatorStatus").innerHTML = "Generator failed";
    console.error(error);
  }
}

// ====================================
// THREE.JS WORLD
// ====================================

let scene;
let camera;
let renderer;
let objects={};

// Zoom bounds — clamps how far in/out a researcher can scroll
const ZOOM_MIN = 15;
const ZOOM_MAX = 300;

function initThree(){

  scene = new THREE.Scene();

  camera = new THREE.PerspectiveCamera(
    60,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
  );

  camera.position.z=80;

  renderer = new THREE.WebGLRenderer({ antialias:true });

  renderer.setSize(window.innerWidth, window.innerHeight);

  document.body.appendChild(renderer.domElement);

  window.addEventListener("resize", ()=>{
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  // Mouse-wheel zoom: scroll up to zoom in, down to zoom out.
  // Clamped between ZOOM_MIN and ZOOM_MAX so researchers can't
  // scroll the camera through the scene or lose it entirely.
  renderer.domElement.addEventListener("wheel", (e)=>{

    e.preventDefault();

    let zoomSpeed = camera.position.z * 0.1;

    camera.position.z += (e.deltaY > 0 ? 1 : -1) * zoomSpeed;

    camera.position.z = Math.max(
      ZOOM_MIN,
      Math.min(ZOOM_MAX, camera.position.z)
    );

  }, { passive:false });

}

// ====================================
// PARTICLES
// ====================================

function createAgent(id){

  let geometry = new THREE.SphereGeometry(2.5, 10, 10);
  let material = new THREE.MeshBasicMaterial({ color:0x3399ff });
  let mesh = new THREE.Mesh(geometry, material);

  scene.add(mesh);
  objects[id]=mesh;

  return mesh;
}

function updateAgents(data){

  for(let agent of data){

    let mesh = objects[agent.id];

    if(!mesh){
      mesh=createAgent(agent.id);
    }

    mesh.position.x = agent.x;
    mesh.position.y = agent.y;
    mesh.material.color.setHex(agent.color);
  }
}

// ====================================
// RESEARCHER READOUT
// ====================================

function renderEvents(events){

  let logEl = document.getElementById("event-log");

  if(!events || events.length === 0){
    logEl.innerHTML = "No events yet — population is stable.";
    return;
  }

  logEl.innerHTML = events.map(ev => {

    let t = new Date(ev.time * 1000);
    let timeStr = t.toLocaleTimeString();

    return `<div class="event-line">[${timeStr}] ${ev.message}</div>`;

  }).join("");

}

async function syncEvents(){

  try{

    let response = await fetch(API + "/events?limit=40");
    let events = await response.json();

    renderEvents(events);

  }
  catch(error){

    console.log("event sync failed", error);

  }

}

// ====================================
// API SYNC
// ====================================

async function sync(){


  try{
    let agentsResponse = await fetch(API+"/visual_agents");
    let agents = await agentsResponse.json();
    updateAgents(agents);

    let telemetryResponse = await fetch(API+"/telemetry");
    let telemetry = await telemetryResponse.json();

    document.getElementById("connection").innerHTML = "● OROBORO BACKEND ONLINE";
    document.getElementById("connection").className = "status online";

    document.getElementById("telemetry").innerHTML = JSON.stringify(telemetry, null, 2);
  }
  catch(error){
    document.getElementById("connection").innerHTML = "● BACKEND OFFLINE";
    document.getElementById("connection").className = "status offline";
    console.log(error);
  }
}

// ====================================
// SCENARIO MEMORY
// (kept in-memory instead of localStorage — see note below)
// ====================================

let savedScenario = null;

function saveScenario(){

  let data={
    intervention: document.getElementById("intervention").value
  };

  savedScenario = data;
  alert("Scenario Saved");
}

function loadScenario(){

  if(savedScenario){
    document.getElementById("intervention").value = savedScenario.intervention;
  } else {
    alert("No saved scenario found");
  }
}

// ====================================
// RENDER LOOP
// ====================================

function animate(){
  requestAnimationFrame(animate);
  scene.rotation.y +=0.0005;
  renderer.render(scene, camera);
}

initThree();
animate();

setInterval(sync, 500);
setInterval(syncEvents, 1000);

</script>


</body>

</html>
